# ============================================
# AWS Configuration (From Terraform Outputs)
# ============================================

# AWS Region
AWS_REGION=us-east-1

# AWS Account ID (from: aws sts get-caller-identity)
AWS_ACCOUNT_ID=123456789012

# IAM Role ARN for Bedrock Access (from terraform output)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/noa-bedrock-role-prod

# ============================================
# Database Configuration (Vercel Managed)
# ============================================

# DynamoDB table name
DYNAMODB_TABLE_NAME=noa-data

# DynamoDB partition key name
DYNAMODB_TABLE_PARTITION_KEY=id

# ============================================
# S3 Storage Configuration (Terraform Provisioned)
# ============================================

# Main S3 bucket for audio and documents
S3_BUCKET=noa-audio-prod-123456789012
S3_REGION=us-east-1

# Backup S3 bucket (optional)
S3_BACKUP_BUCKET=noa-backup-prod-123456789012

# Max file upload size (in bytes)
S3_MAX_FILE_SIZE=52428800  # 50MB

# ============================================
# Bedrock Configuration
# ============================================

# Bedrock region
BEDROCK_REGION=us-east-1

# Nova Lite model ID (for SOAP notes, triage, patient summaries)
BEDROCK_NOVA_LITE_MODEL=us.anthropic.claude-3-5-sonnet-20241022

# Nova Pro model ID (for advanced clinical analysis)
BEDROCK_NOVA_PRO_MODEL=us.anthropic.claude-3-5-sonnet-20241022

# Sonic model ID (for voice processing)
BEDROCK_SONIC_MODEL=amazon.nova-lite-v1:0

# Max tokens for model responses
BEDROCK_MAX_TOKENS=2048

# Temperature for model creativity (0-1)
BEDROCK_TEMPERATURE=0.7

# ============================================
# CloudWatch Monitoring (Optional)
# ============================================

# CloudWatch log group name
CLOUDWATCH_LOG_GROUP=/aws/noa/prod

# Log retention in days
LOG_RETENTION_DAYS=30

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# Application Configuration
# ============================================

# Application environment
NODE_ENV=production

# If running locally outside Vercel, use your normal AWS credential chain
# such as AWS_PROFILE or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.

# Application URL
NEXT_PUBLIC_APP_URL=https://noa.yourdomain.com

# Port for development server
PORT=3000

# ============================================
# Session & Security
# ============================================

# Session timeout in minutes
SESSION_TIMEOUT=60

# JWT secret (generate: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here

# CORS allowed origins
CORS_ORIGINS=https://noa.yourdomain.com

# ============================================
# Features & Flags
# ============================================

# Enable voice recording
ENABLE_VOICE_RECORDING=true

# Enable real-time suggestions
ENABLE_REALTIME_SUGGESTIONS=true

# Enable automated SOAP generation
ENABLE_AUTO_SOAP_GENERATION=true

# Enable patient intake forms
ENABLE_PATIENT_INTAKE=true

# Enable clinical insights
ENABLE_CLINICAL_INSIGHTS=true

# ============================================
# Email Configuration (Optional)
# ============================================

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noa@yourdomain.com

# ============================================
# Monitoring & Alerts (Optional)
# ============================================

# Sentry error tracking
SENTRY_DSN=https://key@sentry.io/project-id

# Datadog APM
DATADOG_API_KEY=your-datadog-key

# ============================================
# Development Specific (Optional)
# ============================================

# Debug mode
DEBUG=false

# Use mock Bedrock responses (for testing)
USE_MOCK_BEDROCK=false

# Use mock database (for testing)
USE_MOCK_DATABASE=false

# ============================================
# Terraform & Infrastructure
# ============================================

# Terraform state location (for reference)
TERRAFORM_STATE_BUCKET=noa-terraform-state
TERRAFORM_ENVIRONMENT=prod
