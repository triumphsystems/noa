# ============================================
# AWS Configuration (from: terraform output)
# ============================================

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# Single IAM role for Bedrock + DynamoDB + S3 (from: terraform output app_role_arn)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/noa-app-role-prod

# ============================================
# DynamoDB (from: terraform output dynamodb_table_name)
# ============================================

DYNAMODB_TABLE_NAME=noa-data

# ============================================
# S3 Storage (from: terraform output s3_bucket_name)
# ============================================

S3_BUCKET=noa-audio-prod-123456789012
S3_REGION=us-east-1

# Backup bucket — only set if enable_s3_replication = true in Terraform
# S3_BACKUP_BUCKET=noa-backup-prod-123456789012

# Max upload size in bytes (50 MB)
S3_MAX_FILE_SIZE=52428800

# ============================================================
# Bedrock — Tri-Model Architecture
# ============================================================
# Bedrock endpoint region (must be a region where Nova models are available)
# Recommended: us-east-1 regardless of your app region
BEDROCK_REGION=us-east-1

# Nova 2 Lite — FAST TIER
# Clinical suggestions, intake text extraction, SOAP drafts, structured JSON
# Global cross-region inference (routes to best available US/global region)
# Valid: global.amazon.nova-2-lite-v1:0 | us.amazon.nova-2-lite-v1:0 | amazon.nova-2-lite-v1:0
BEDROCK_NOVA_LITE_MODEL=global.amazon.nova-2-lite-v1:0

# Nova Pro — REASONING TIER
# Deep clinical reasoning, post-visit SOAP synthesis, differential diagnosis, ICD-10 coding
# Global cross-region inference
# Valid: global.amazon.nova-pro-v1:0 | us.amazon.nova-pro-v1:0 | amazon.nova-pro-v1:0
BEDROCK_NOVA_PRO_MODEL=global.amazon.nova-pro-v1:0

# Nova 2 Sonic — VOICE TIER (patient intake bidirectional audio ONLY)
# Used exclusively via Vercel WebSocket → InvokeModelWithBidirectionalStream
# IMPORTANT: Do NOT use global. or us. prefix — not supported for bidirectional streaming
# Valid: amazon.nova-2-sonic-v1:0
BEDROCK_SONIC_MODEL=amazon.nova-2-sonic-v1:0

# Maximum output tokens generated per text request (Nova Lite / Nova Pro)
BEDROCK_MAX_TOKENS=2048

# Lower temperature = more deterministic clinical output (0.0–1.0)
BEDROCK_TEMPERATURE=0.3

# ============================================================
# Amazon Transcribe Medical — Ambient Consultation Scribe (30+ min)
# Used for rolling 60-second audio slice transcription during doctor-patient consultations.
# Provides clinical-grade STT: drug names, dosages, anatomical terms, PHI redaction.
# ============================================================

# Medical specialty for Transcribe Medical context
# Options: PRIMARYCARE | CARDIOLOGY | NEUROLOGY | ONCOLOGY | RADIOLOGY | UROLOGY
TRANSCRIBE_MEDICAL_SPECIALTY=PRIMARYCARE

# Conversation type: CONVERSATION (doctor + patient, multi-speaker) | DICTATION (single speaker)
TRANSCRIBE_MEDICAL_TYPE=CONVERSATION


# ============================================
# Clinical AI Provider (Bedrock vs. Real Local LLM)
# ============================================

# 'bedrock' (default, Golden Standard for production) or 'local' (real local inference, e.g. Ollama)
CLINICAL_AI_PROVIDER=bedrock

# Local LLM endpoint (used only when CLINICAL_AI_PROVIDER=local)
LOCAL_AI_ENDPOINT=http://localhost:11434/v1

# Local model name (e.g. llama3.2:latest, biomistral:latest, mistral:latest)
LOCAL_AI_MODEL=llama3.2:latest

# ============================================
# Application
# ============================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://noa.yourdomain.com
PORT=3000

# ============================================
# AWS Cognito Authentication (from: terraform output)
# ============================================

# Cognito User Pool ID (from: terraform output cognito_user_pool_id)
COGNITO_USER_POOL_ID=us-east-1_abcdef123

# Cognito App Client ID (from: terraform output cognito_user_pool_client_id)
COGNITO_CLIENT_ID=1234567890abcdefghijklmnop

# ============================================
# Auth & Security
# ============================================

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

SESSION_TIMEOUT=60
CORS_ORIGINS=https://noa.yourdomain.com


# ============================================
# CloudWatch (only needed if enable_monitoring = true in Terraform)
# ============================================

# CLOUDWATCH_LOG_GROUP=/aws/noa/prod
# LOG_RETENTION_DAYS=30
# LOG_LEVEL=info

# ============================================
# Email Notifications (optional)
# ============================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noa@yourdomain.com

# ============================================
# Error Tracking (optional)
# ============================================

# SENTRY_DSN=https://key@sentry.io/project-id

# ============================================
# Development / Testing
# ============================================

# USE_MOCK_BEDROCK=false
# USE_MOCK_DATABASE=false
